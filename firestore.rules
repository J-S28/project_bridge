rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function callerProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOwnCitizenComplaint() {
      return resource.data.citizenId == request.auth.uid;
    }

    // Only an actual citizen role may confirm/reopen — office staff who
    // logged a complaint on a citizen's behalf share the "own complaint"
    // pattern for creation, but must never gain closing rights from it.
    function isActualCitizen() {
      return callerProfile().role == "citizen";
    }

    function isMatchingOfficer() {
      return callerProfile().role == "officer" &&
        callerProfile().department == resource.data.ai.department &&
        callerProfile().constituency == resource.data.location.ward;
    }

    function isMatchingMLA() {
      return callerProfile().role == "mla" &&
        callerProfile().constituency == resource.data.location.ward;
    }

    function isMatchingMP() {
      return callerProfile().role == "mp" &&
        callerProfile().constituency == resource.data.location.constituencyMP;
    }

    function isMatchingDeptHead() {
      return callerProfile().role == "department_head" &&
        callerProfile().department == resource.data.ai.department &&
        callerProfile().constituency == resource.data.location.constituencyMP;
    }

    function coreFieldsUnchanged() {
      return request.resource.data.citizenId == resource.data.citizenId &&
        request.resource.data.rawText == resource.data.rawText &&
        request.resource.data.ai == resource.data.ai;
    }

    // A citizen reporting the same issue someone else already filed: only
    // reportCount (+1) and reportedByCitizenIds (+ own uid) may change.
    function isJoiningAsDuplicate() {
      return request.resource.data.reportCount == resource.data.reportCount + 1 &&
        request.resource.data.reportedByCitizenIds.size() ==
          resource.data.reportedByCitizenIds.size() + 1 &&
        (request.auth.uid in request.resource.data.reportedByCitizenIds) &&
        request.resource.data.status == resource.data.status;
    }

    function existingRemarksCount() {
      return ("remarks" in resource.data) ? resource.data.remarks.size() : 0;
    }

    // Department Executives, MLAs, and MPs monitor and annotate — a remark
    // is the only write any of them can make that isn't a status change.
    // Exactly one remark may be appended per write; nothing else moves.
    function isAddingRemark() {
      return ("remarks" in request.resource.data) &&
        request.resource.data.remarks.size() == existingRemarksCount() + 1 &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.history == resource.data.history;
    }

    // A Department Executive resetting a stuck case back to the officer's
    // active queue — not a resolution, just a hand-back.
    function isReturningToOfficer() {
      return resource.data.status in ["In Progress", "Escalated", "Waiting for Information"] &&
        request.resource.data.status == "Acknowledged";
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if false;
    }

    match /complaints/{complaintId} {
      allow create: if request.auth != null &&
        request.resource.data.citizenId == request.auth.uid;

      // Civic issue reports aren't sensitive personal data — any signed-in
      // user can read any complaint (needed for duplicate-detection lookups
      // across citizens). Write access stays tightly scoped below.
      allow read: if request.auth != null;

      allow update: if request.auth != null && (
        (coreFieldsUnchanged() && isMatchingOfficer() &&
          request.resource.data.status in
            ["Acknowledged", "In Progress", "Waiting for Information",
             "Escalated", "Pending Citizen Confirmation", "Rejected"]) ||
        (coreFieldsUnchanged() && isOwnCitizenComplaint() && isActualCitizen() &&
          request.resource.data.status in ["Closed", "Reopened"]) ||
        (coreFieldsUnchanged() && isMatchingDeptHead() && isReturningToOfficer()) ||
        ((isMatchingDeptHead() || isMatchingMLA() || isMatchingMP()) &&
          coreFieldsUnchanged() && isAddingRemark()) ||
        (coreFieldsUnchanged() && isJoiningAsDuplicate())
      );

      allow delete: if false;
    }

    match /dashboardCache/{cacheId} {
      allow read, write: if request.auth != null &&
        callerProfile().role in ["mla", "mp"];
      allow delete: if false;
    }

    // Same trust level as complaints: not sensitive, broad read, each
    // dashboard's own query narrows to its relevant scope client-side.
    // Write access is tight — create is unrestricted (any action can raise
    // a notification), but the only allowed update is marking your own uid
    // as having read it.
    match /notifications/{notificationId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readBy"]) &&
        request.resource.data.readBy.size() == resource.data.readBy.size() + 1 &&
        request.auth.uid in request.resource.data.readBy;
      allow delete: if false;
    }
  }
}
